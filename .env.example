# ── AuraDB (modules 1–4, Bolt backend) ──────────────────────────────
# From your free AuraDB instance (create before the workshop — see pre-work email):
#   NEO4J_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
# NEO4J_DATABASE=        # optional: detected from your instance when left unset

# ── OpenAI (chat, embeddings, LLM extraction — ADR 001) ─────────────
# Prefer setting this as a personal Codespaces secret scoped to this repo
# (Settings → Codespaces → Secrets). .env is the fallback.
OPENAI_API_KEY=

# ── NAMS (module 5 — sign up during pre-work, not in-session) ────────
# From https://memory.neo4jlabs.com (early access; see module 5):
NAMS_API_KEY=            # nams_...

# Lesson configuration (also read from .env; restart after changes)
# ONTOLOGY=acme_cloud  # default-poleo | active
# VALIDATION_MODE=permissive  # strict also drops undeclared entity types
# MEMORY_NAMESPACE=workshop
# AGENT_REASONING_RETRIEVAL=true
# DATA_DIR=/absolute/path/to/separate/lesson-data
